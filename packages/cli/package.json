{
	"name": "seostudio",
	"version": "0.1.0",
	"description": "Free SEO site audit from your terminal, plus a local MCP server and a crawl agent for SEOStudio projects.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DigitalFrontLLP/SEOStudio.git",
		"directory": "packages/cli"
	},
	"homepage": "https://seostudio.com",
	"type": "module",
	"bin": {
		"seostudio": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"seo",
		"site-audit",
		"crawler",
		"mcp",
		"cli"
	],
	"scripts": {
		"build": "tsup",
		"check-types": "tsc --noEmit",
		"dev": "tsx src/cli.ts"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@seostudio/audit-engine": "^0.1.0",
		"@types/node": "26.6.5",
		"tsup": "^9.0.0",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"zod": "4.6.7"
	}
}
