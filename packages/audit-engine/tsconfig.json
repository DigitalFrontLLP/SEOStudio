{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"lib": [
			"es2022",
			"DOM",
			"DOM.iterable"
		],
		"types": [
			"node"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src",
		"scripts"
	]
}
